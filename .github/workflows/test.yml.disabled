# FloraFlow test workflow — PLACEHOLDER / NOT ACTIVE.
#
# CI is currently dormant for this repo (the FTP hosting that deploy.yml targets
# is no longer used and its credentials have expired). This file is kept with a
# `.disabled` suffix so GitHub does not run it. To enable: rename to `test.yml`
# and confirm the `on:` branches match how the repo is actually used.

name: Tests

on:
    push:
        branches: [main]
    pull_request:
        branches: [main]

jobs:
    test:
        runs-on: ubuntu-latest
        strategy:
            fail-fast: false
            matrix:
                app: [client, server]
        defaults:
            run:
                working-directory: ${{ matrix.app }}
        steps:
            - uses: actions/checkout@v4
            - uses: actions/setup-node@v4
              with:
                  node-version: 20
                  cache: npm
                  cache-dependency-path: ${{ matrix.app }}/package-lock.json
            - run: npm ci
            - run: npm test
